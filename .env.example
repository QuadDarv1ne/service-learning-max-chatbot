# =============================================================================
# Чат-бот MAX — программа «Обучение служением. Первые»
# Пример переменных окружения.
#
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# ВАЖНО: файл .env НЕ должен попадать в git — он в .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# База данных (обязательно)
# -----------------------------------------------------------------------------
# SQLite. Путь в формате Prisma (схема file:).
# Для локальной разработки достаточно относительного пути:
DATABASE_URL="file:./db/custom.db"
# В продакшене лучше хранить базу вне исходников, например:
# DATABASE_URL="file:/opt/max-bot/data/custom.db"


# -----------------------------------------------------------------------------
# Админ-панель (обязательно)
# -----------------------------------------------------------------------------
# Пароль для входа в веб-интерфейс администратора.
# ОБЯЗАТЕЛЬНО смените значение по умолчанию в продакшене (минимум 12 символов).
ADMIN_PASSWORD="change-me-strong-password"


# -----------------------------------------------------------------------------
# MAX Bot API (опционально)
# -----------------------------------------------------------------------------
# Токен бота можно задать здесь ИЛИ через UI админ-панели (Настройки → токен).
# Значение из БД имеет приоритет над переменной окружения.
# Токен выдаётся на Портале для бизнеса MAX: https://business.max.ru/self
#   раздел «Чат-боты» → выберите бота → ⋮ → «Настройки» → «Токен доступа»
# MAX_BOT_TOKEN=""


# -----------------------------------------------------------------------------
# Cron / планировщик рассылок (опционально)
# -----------------------------------------------------------------------------
# Секрет для вызова POST /api/broadcasts/process из внешнего cron.
# Передаётся в заголовке X-Cron-Secret. Если не задан — доступ только по сессии.
# CRON_SECRET="generate-a-long-random-string"


# -----------------------------------------------------------------------------
# Прочее (опционально)
# -----------------------------------------------------------------------------
# Режим работы Next.js. В продакшене обычно не задаётся вручную.
# NODE_ENV="production"
